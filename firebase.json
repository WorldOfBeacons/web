{
  "hosting": {
    "target": "www",
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**",
      "CNAME",
      "README*",
      "docs/**",
      "scripts/**",
      "package.json",
      "package-lock.json",
      "pnpm-lock.yaml",
      "yarn.lock",
      "**/*.pem",
      "**/*.key",
      "**/*service-account*.json"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "public,max-age=0,must-revalidate" },
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      },
      {
        "source": "/**/*.@(svg|png|jpg|jpeg|webp|gif|ico|mp4)",
        "headers": [
          { "key": "Cache-Control", "value": "public,max-age=3600" }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          { "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }
        ]
      }
    ]
  }
}
